#!/bin/zsh
# Build the GenBridge VST3 plug-in.
#
# A script rather than an Xcode target, for the reason G2-Edit's do-vst3 is one: a .vst3 is a bundle
# around a single dylib and needs no build system to say so.
#
# Only pluginterfaces/ from the SDK is compiled, plus the one file that instantiates the interface
# IIDs the headers declare. No CMake, no vstgui, no public.sdk helper classes.

set -e

SDK="${VST3_SDK:-$HOME/Documents/vst3sdk}"
HERE="$(cd "$(dirname "$0")" && pwd)"
DEFAULT_OUT="$HERE/build/GenBridge.vst3"
OUT="${GENBRIDGE_VST3_OUT:-$DEFAULT_OUT}"
BIN="$OUT/Contents/MacOS/GenBridge"

if [[ ! -d "$SDK/pluginterfaces" ]]; then
    print -u2 "error: VST3 SDK not found at $SDK"
    print -u2 "       set VST3_SDK to its location"
    exit 1
fi

# The bridge core, shared verbatim with the command line tool in poc/. Deliberately NOT
# genbridge.c or selftest.c - those are the CLI and the measurement harness, and if this list ever
# needs one of them, something that should have stayed reusable has grown a dependency on main().
C_SOURCES=(
    "$HERE/poc/device.c"
    "$HERE/poc/ring.c"
    "$HERE/poc/resampler.c"
    "$HERE/poc/drift.c"
    "$HERE/vst3/gbStatus.c"
    "$HERE/vst3/gbMidi.c"
    "$HERE/vst3/gbDraw.c"
    "$HERE/vst3/gbAppStubs.c"

    # SynthLib, and only the parts a plug-in panel needs. Deliberately NOT the menu bar, the popup
    # or context-menu system, the file or bank browsers, or synthlibWindow.c - the first four are
    # for a full application UI and the last one owns a GLFW window, which a plug-in has no business
    # creating. This list is MANUAL: nothing here is a synchronised folder, so a new SynthLib file
    # that becomes necessary has to be added by hand.
    "$HERE/SynthLib/src/utilsGraphics.c"
    "$HERE/SynthLib/src/renderBackend.c"
    "$HERE/SynthLib/src/renderBackendGL.c"
    "$HERE/SynthLib/src/geometry.c"
    "$HERE/SynthLib/src/utils.c"
    "$HERE/SynthLib/src/synthlibHost.c"
    "$HERE/SynthLib/src/synthlibMidi.c"
    "$HERE/SynthLib/src/contextMenu.c"
    "$HERE/SynthLib/src/clickRegion.c"
    "$HERE/SynthLib/src/inputState.c"
    "$HERE/SynthLib/src/synthlibVersion.c"
)

# Objective-C. Plain, not Objective-C++: the drawing surface needs the runtime but no C++, and
# keeping it separate confines C++ to the one file that genuinely has to speak it.
OBJC_SOURCES=(
    "$HERE/vst3/gbView.m"
    "$HERE/SynthLib/src/renderBackendMetal.m"
)

# The SDK files that carry no logic: they exist solely to define the interface IIDs the headers
# declare, plus FUnknown's own helpers. Nothing else from the SDK is compiled.
# Objective-C++ for the editor: it builds an AppKit view and hands it to the host, and IPlugView is
# a C++ interface, so this one file has to speak both.
OBJCPP_SOURCES=(
    "$HERE/vst3/gbEditor.mm"
)

CPP_SOURCES=(
    "$HERE/vst3/gbVst3.cpp"
    "$SDK/pluginterfaces/base/funknown.cpp"
    "$SDK/pluginterfaces/base/coreiids.cpp"
    "$SDK/public.sdk/source/vst/vstinitiids.cpp"

    # IPlugView's own IID lives here rather than in coreiids.cpp - the editor needs it, a plug-in
    # without one does not.
    "$SDK/public.sdk/source/common/commoniids.cpp"
)

DEPLOYMENT_TARGET=11.5

# glfw is here for its HEADERS ONLY - SynthLib's key and mouse constants come from them, which is
# enum leakage rather than a dependency, so the library itself is never built or linked. freetype is
# the one real library the renderer needs, taken as a static build so the bundle stays self
# contained.
INCLUDES=(-I"$HERE/poc" -I"$HERE/vst3" -I"$HERE/SynthLib/src" -I"$SDK"
          -I"$HERE/SynthLib/ThirdParty/glfw/include"
          -I"$HERE/SynthLib/ThirdParty/freetype/include")

# G2_VST3_BUILD is SynthLib's "this is a plug-in, there is no GLFW" switch, and it is what compiles
# the GLFW calls out of renderBackendGL.c's gl_present(). The name is G2-specific for historical
# reasons and would be better as something neutral, but renaming it is a SynthLib change that would
# ripple through all four projects - worth doing, not worth doing today.
# THE VERSION THE BUNDLE AND THE HOST BOTH REPORT. The default is for an ordinary developer build;
# do-release overrides it so a released .dmg does not ship a plug-in calling itself 0.1.0 for ever.
# It reaches the code as a define rather than being edited into gbVst3.cpp, so there is one place to
# change it and no way for the Info.plist and the class info to disagree - and the class info is
# what a host puts in front of the user.
GENBRIDGE_VERSION="${GENBRIDGE_VERSION:-0.1.0}"

# AN ARRAY, not a string. These are expanded unquoted at four compile sites, and the version define
# has to carry its own quotes through to clang (-DGB_VERSION_STRING="\"1.2.3\"") so the macro is a C
# string literal. In a string that survives exactly until the first word split.
PLUGIN_DEFS=(-DG2_VST3_BUILD=1 -DGB_VERSION_STRING="\"$GENBRIDGE_VERSION\"")

FREETYPE_LIB="$HERE/SynthLib/ThirdParty/freetype/build/libfreetype.a"

if [[ ! -f "$FREETYPE_LIB" ]]; then
    print -u2 "error: freetype not built at $FREETYPE_LIB"
    print -u2 "       see the build notes in G2-Edit/Docs/Third Party build notes.txt"
    exit 1
fi

rm -rf "$OUT"
mkdir -p "$OUT/Contents/MacOS"

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

print "building GenBridge.vst3 (arm64 + x86_64)"

for ARCH in arm64 x86_64; do
    OBJS=()

    for SRC in "${C_SOURCES[@]}"; do
        OBJ="$WORK/$(basename ${SRC%.c})-$ARCH.o"
        clang -c -arch "$ARCH" -mmacosx-version-min=$DEPLOYMENT_TARGET \
            -std=gnu11 -O2 -Wall -Wextra "${PLUGIN_DEFS[@]}" \
            "${INCLUDES[@]}" -o "$OBJ" "$SRC"
        OBJS+=("$OBJ")
    done

    for SRC in "${OBJC_SOURCES[@]}"; do
        OBJ="$WORK/$(basename ${SRC%.m})-$ARCH.o"
        clang -c -arch "$ARCH" -mmacosx-version-min=$DEPLOYMENT_TARGET \
            -fobjc-arc -std=gnu11 -O2 -Wall -Wextra "${PLUGIN_DEFS[@]}" \
            "${INCLUDES[@]}" -o "$OBJ" "$SRC"
        OBJS+=("$OBJ")
    done

    for SRC in "${OBJCPP_SOURCES[@]}"; do
        OBJ="$WORK/$(basename ${SRC%.mm})-$ARCH.o"
        clang++ -c -arch "$ARCH" -mmacosx-version-min=$DEPLOYMENT_TARGET \
            -fobjc-arc -std=gnu++17 -O2 -Wall -Wextra "${PLUGIN_DEFS[@]}" \
            "${INCLUDES[@]}" -o "$OBJ" "$SRC"
        OBJS+=("$OBJ")
    done

    for SRC in "${CPP_SOURCES[@]}"; do
        OBJ="$WORK/$(basename ${SRC%.cpp})-$ARCH.o"
        clang++ -c -arch "$ARCH" -mmacosx-version-min=$DEPLOYMENT_TARGET \
            -std=gnu++17 -O2 -Wall -Wextra "${PLUGIN_DEFS[@]}" \
            "${INCLUDES[@]}" -o "$OBJ" "$SRC"
        OBJS+=("$OBJ")
    done

    clang++ -arch "$ARCH" -mmacosx-version-min=$DEPLOYMENT_TARGET \
        -bundle \
        -framework CoreAudio -framework CoreMIDI -framework CoreFoundation -framework Cocoa \
        -framework Metal -framework QuartzCore -framework OpenGL \
        -o "$WORK/GenBridge-$ARCH" "${OBJS[@]}" "$FREETYPE_LIB"
done

lipo -create -output "$BIN" "$WORK/GenBridge-arm64" "$WORK/GenBridge-x86_64"

# A bundle needs its Info.plist and the four-character PkgInfo, or the host will not look inside it.
cat > "$OUT/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key><string>GenBridge</string>
    <key>CFBundleIdentifier</key><string>com.chrispurusha.genbridge.vst3</string>
    <key>CFBundleName</key><string>GenBridge</string>
    <key>CFBundlePackageType</key><string>BNDL</string>
    <key>CFBundleSignature</key><string>????</string>
    <key>CFBundleShortVersionString</key><string>$GENBRIDGE_VERSION</string>
    <key>CFBundleVersion</key><string>$GENBRIDGE_VERSION</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>LSMinimumSystemVersion</key><string>11.5</string>
</dict>
</plist>
PLIST

printf 'BNDL????' > "$OUT/Contents/PkgInfo"

# Ad-hoc signed: there is no paid Apple membership behind this, so a host may still need the
# quarantine flag cleared before it will load the bundle.
codesign --force --sign - "$OUT" 2>/dev/null || print -u2 "warning: ad-hoc signing failed"

print ""
print "Built: $OUT"
print "Architectures: $(lipo -archs "$BIN")"

# Install straight into the VST3 folder. A plug-in that is not where a host looks for it has not
# really been built, and the alternative is remembering a copy command after every single build.
#
# THE SYSTEM-WIDE FOLDER, matching what the .dmg tells users. /Library/Audio/Plug-Ins/VST3 is
# root:admin and group-writable, so an administrator account writes to it without sudo, and it is
# where every commercial installer puts its plug-ins. Developing against the per-user folder while
# shipping instructions for the system one is how you end up debugging a difference that is really
# just two copies.
#
# REPLACED, not copied over. cp -R onto an existing bundle merges: a file dropped from the build
# survives in the installed copy and can go on being loaded long after it left the source tree.
#
# Set GENBRIDGE_NO_INSTALL=1 to build without touching the installed copy, or
# GENBRIDGE_VST3_INSTALL to point somewhere else.
INSTALL_DIR="${GENBRIDGE_VST3_INSTALL:-/Library/Audio/Plug-Ins/VST3}"
INSTALLED="$INSTALL_DIR/$(basename "$OUT")"

# A BUILD SENT SOMEWHERE ELSE IS NOT A BUILD TO INSTALL. Naming the output explicitly always means
# "put it there, for a purpose of my own" - an A/B against an older revision, a release's own tree -
# and installing it as well is never what was wanted. It is also actively harmful: the copy lands
# under the OUTPUT's basename while declaring the SAME VST3 class ids as GenBridge.vst3, so a host
# indexing by class id then has two bundles claiming to be this plug-in and may load either. That
# exact mistake was made on the sibling project MidiSyncTool and cost real time to find.
if [[ -n "$GENBRIDGE_NO_INSTALL" ]]; then
    print ""
    print "Not installed (GENBRIDGE_NO_INSTALL is set)."
    print "  cp -R \"$OUT\" \"$INSTALL_DIR/\""
elif [[ "$OUT" != "$DEFAULT_OUT" ]]; then
    print ""
    print "Not installed: GENBRIDGE_VST3_OUT names a build of its own, not the working copy."
    print "               (set GENBRIDGE_VST3_INSTALL if you really want it installed somewhere)"
else
    if ! mkdir -p "$INSTALL_DIR" 2>/dev/null || [[ ! -w "$INSTALL_DIR" ]]; then
        print -u2 "error: cannot write to $INSTALL_DIR"
        print -u2 "       it is normally group-writable by admin users. Either run:"
        print -u2 "           sudo mkdir -p \"$INSTALL_DIR\" && sudo chgrp admin \"$INSTALL_DIR\" && sudo chmod g+w \"$INSTALL_DIR\""
        print -u2 "       or install elsewhere: GENBRIDGE_VST3_INSTALL=~/Library/Audio/Plug-Ins/VST3 ./do-vst3"
        exit 1
    fi

    # A COPY IN THE OTHER FOLDER OUTRANKS NOTHING - hosts scan both and may list the plug-in twice,
    # or load whichever they reach first. That is a very convincing way to spend an afternoon fixing
    # a bug that was fixed already, in the copy the host is not loading.
    for OTHER in "$HOME/Library/Audio/Plug-Ins/VST3" "/Library/Audio/Plug-Ins/VST3"; do
        if [[ "$OTHER" != "$INSTALL_DIR" && -d "$OTHER/$(basename "$OUT")" ]]; then
            print -u2 ""
            print -u2 "warning: another copy is installed at"
            print -u2 "           $OTHER/$(basename "$OUT")"
            print -u2 "         hosts scan both folders. Remove it, or your host may load that one:"
            print -u2 "           rm -rf \"$OTHER/$(basename "$OUT")\""
        fi
    done

    # Only ever remove something that is a bundle with the name we are about to write, so a
    # mistyped INSTALL_DIR cannot turn this into a wider delete.
    if [[ -d "$INSTALLED" && "$INSTALLED" == *.vst3 ]]; then
        rm -rf "$INSTALLED"
    fi

    cp -R "$OUT" "$INSTALL_DIR/"

    # Unnotarized, so the quarantine flag would otherwise stop a host loading it.
    xattr -dr com.apple.quarantine "$INSTALLED" 2>/dev/null || true

    print ""
    print "Installed: $INSTALLED"
    print "  (a host already running keeps the copy it loaded until it rescans or restarts)"
fi

print ""
print "Device selection, in order: the host-saved UID, then \$GENBRIDGE_DEVICE."
print "A host launched from the Dock inherits no shell environment, so the variable"
print "only helps a scripted run - see the note in gbVst3.cpp."
