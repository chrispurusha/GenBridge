#!/bin/zsh
# Build the GenBridge proof of concept.
#
# A script rather than an Xcode project, for the same reason G2-Edit's do-plugin is one: this is a
# handful of C files and two system frameworks, and a build system would only be in the way. When
# the plug-in wrapper arrives it can bring an Xcode project with it if it needs one.

set -e

HERE="$(cd "$(dirname "$0")" && pwd)"
OUT="${GENBRIDGE_OUT:-$HERE/build}"
BIN="$OUT/genbridge"

SOURCES=(
    "$HERE/poc/genbridge.c"
    "$HERE/poc/resampler.c"
    "$HERE/poc/drift.c"
    "$HERE/poc/selftest.c"
)

SL="${SYNTHLIB_DIR:-$HERE/../SynthLib}"

# Matching SynthLib's, or the link warns "object file was built for newer macOS version".
DEPLOYMENT_TARGET=12.0

"$SL/do-build"

mkdir -p "$OUT"

print "building genbridge (arm64 + x86_64)"

for ARCH in arm64 x86_64; do
    clang \
        -arch "$ARCH" \
        -mmacosx-version-min=$DEPLOYMENT_TARGET \
        -std=c11 \
        -O2 \
        -Wall -Wextra -Werror \
        -I"$HERE/poc" \
        -I"$SL/audio" \
        -framework CoreAudio \
        -framework CoreFoundation \
        -o "$OUT/genbridge-$ARCH" \
        "${SOURCES[@]}" "$SL/build/libSynthLib.a"
done

lipo -create -output "$BIN" "$OUT/genbridge-arm64" "$OUT/genbridge-x86_64"
rm -f "$OUT/genbridge-arm64" "$OUT/genbridge-x86_64"

# Ad-hoc, like the sibling projects - there is no paid Apple Developer membership behind these.
# A command line tool needs no entitlements, so this is only about having a stable code identity.
codesign --force --sign - "$BIN" 2>/dev/null || true

print "built $BIN"
lipo -info "$BIN"
