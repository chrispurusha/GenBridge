#!/bin/zsh
#
# Builds "GenBridge Monitor.app" - route an input pair to an output pair with as little delay as two
# clocks allow (monitor/, Docs/code-notes/gmEngine.c.md). Universal (arm64 + x86_64), ad-hoc signed.
#
#   ./do-monitor                 build into build/ and replace /Applications/GenBridge Monitor.app
#   ./do-monitor --no-install    build only (what do-release uses)
#
# A script rather than an Xcode project, for the same reason do-plugin is one. The engine is the proof of
# concept's (poc/drift.c, poc/resampler.c) over SynthLib's ring and device layer; the window is SynthLib's
# panel view, the one GenBridge's plug-in editor uses.

set -e

HERE="$(cd "$(dirname "$0")" && pwd)"
SL="${SYNTHLIB_DIR:-$HERE/../SynthLib}"

INSTALL=1

for arg in "$@"; do
    case "$arg" in
        --no-install) INSTALL=0 ;;
        *)
            print -u2 "usage: ${0:t} [--no-install]"
            exit 2
            ;;
    esac
done

APP_NAME="GenBridge Monitor"
EXE_NAME="GenBridgeMonitor"
BUNDLE_ID="com.chrispurusha.genbridge.monitor"
GENBRIDGE_VERSION="${GENBRIDGE_VERSION:-0.1.0}"
OUT_DIR="${GENBRIDGE_PLUGIN_OUT_DIR:-$HERE/build}"
INSTALL_DIR="${GENBRIDGE_MONITOR_INSTALL:-/Applications}"

"$SL/do-build"
SYNTHLIB_LIB="$SL/build/libSynthLib.a"
FREETYPE_LIB="$SL/build/libfreetype.a"

SOURCES=(
    "$HERE/monitor/gmEngine.c"
    "$HERE/monitor/gmDraw.c"
    "$HERE/monitor/gmSettings.c"
    "$HERE/monitor/gmInsert.c"
    "$HERE/poc/resampler.c"
    "$HERE/poc/drift.c"
)

OBJC_SOURCES=(
    "$HERE/monitor/gmApp.m"
)

WARNFLAGS=(-Wall -Wextra)
DEFS=(-DGM_VERSION_STRING="\"$GENBRIDGE_VERSION\"")
INCLUDES=(-I"$HERE/monitor" -I"$HERE/poc" -I"$SL/src" -I"$SL/audio" -I"$SL/plugin"
          -I"$SL/ThirdParty/glfw/include" -I"$SL/ThirdParty/freetype/include")
ARCHS=(-arch arm64 -arch x86_64)
MIN=-mmacosx-version-min=12.0
LIBS=(-framework CoreAudio -framework CoreMIDI -framework CoreFoundation -framework Cocoa -framework AudioToolbox
      -framework Metal -framework QuartzCore)

OBJDIR="$(mktemp -d)"
trap 'rm -rf "$OBJDIR"' EXIT

print "GenBridge Monitor $GENBRIDGE_VERSION (arm64 + x86_64)"

objects=()

for src in "${SOURCES[@]}"; do
    obj="$OBJDIR/$(basename "${src%.*}").o"
    clang $ARCHS $MIN -O2 -std=gnu11 "${WARNFLAGS[@]}" "${DEFS[@]}" "${INCLUDES[@]}" -c "$src" -o "$obj"
    objects+=("$obj")
done

for src in "${OBJC_SOURCES[@]}"; do
    obj="$OBJDIR/$(basename "${src%.*}").om"
    clang $ARCHS $MIN -O2 -std=gnu11 -fobjc-arc "${WARNFLAGS[@]}" "${DEFS[@]}" "${INCLUDES[@]}" \
          -x objective-c -c "$src" -o "$obj"
    objects+=("$obj")
done

app="$OUT_DIR/$APP_NAME.app"
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"

clang++ $ARCHS $MIN -Wl,-dead_strip "${objects[@]}" "$SYNTHLIB_LIB" "$FREETYPE_LIB" "${LIBS[@]}" -o "$app/Contents/MacOS/$EXE_NAME"

# The icon, from the one 1024-pixel artwork (monitor/icon/make_icon.py draws it), at every size macOS asks for.
ICON_SRC="$HERE/monitor/icon/AppIcon-1024.png"
ICONSET="$OBJDIR/AppIcon.iconset"
mkdir -p "$ICONSET"
for size in 16 32 128 256 512; do
    sips -z $size $size "$ICON_SRC" --out "$ICONSET/icon_${size}x${size}.png" >/dev/null
    sips -z $((size * 2)) $((size * 2)) "$ICON_SRC" --out "$ICONSET/icon_${size}x${size}@2x.png" >/dev/null
done
iconutil -c icns "$ICONSET" -o "$app/Contents/Resources/AppIcon.icns"

# NSMicrophoneUsageDescription: macOS asks before any app may read an audio INPUT, and without the string
# the request is refused silently - the input then delivers zeros, which looks exactly like a dead cable.
cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>               <string>$APP_NAME</string>
    <key>CFBundleDisplayName</key>        <string>$APP_NAME</string>
    <key>CFBundleExecutable</key>         <string>$EXE_NAME</string>
    <key>CFBundleIconFile</key>           <string>AppIcon</string>
    <key>CFBundleIdentifier</key>         <string>$BUNDLE_ID</string>
    <key>CFBundlePackageType</key>        <string>APPL</string>
    <key>CFBundleShortVersionString</key> <string>$GENBRIDGE_VERSION</string>
    <key>CFBundleVersion</key>            <string>$GENBRIDGE_VERSION</string>
    <key>LSMinimumSystemVersion</key>     <string>12.0</string>
    <key>NSHighResolutionCapable</key>    <true/>
    <key>NSPrincipalClass</key>           <string>NSApplication</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>GenBridge Monitor passes the input you choose straight to the output you choose.</string>
</dict>
</plist>
PLIST
print -n "APPL????" > "$app/Contents/PkgInfo"

codesign --force --sign - "$app" 2>/dev/null || print -u2 "warning: ad-hoc signing failed for $app"

print "Built: $app  ($(lipo -archs "$app/Contents/MacOS/$EXE_NAME"))"

if [[ $INSTALL -eq 1 ]]; then
    if pgrep -xq "$EXE_NAME"; then
        # Never kill it: quitting is the app's own, and it puts device buffers back on the way.
        print "Not installing: $APP_NAME is running - quit it and run ${0:t} again."
    else
        rm -rf "$INSTALL_DIR/$APP_NAME.app"
        cp -R "$app" "$INSTALL_DIR/"
        xattr -dr com.apple.quarantine "$INSTALL_DIR/$APP_NAME.app" 2>/dev/null || true
        print "Installed: $INSTALL_DIR/$APP_NAME.app"
    fi
fi
